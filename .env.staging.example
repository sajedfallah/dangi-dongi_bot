APP_NAME=dangi-dongi-staging
ENV=staging

# Telegram test/staging bot. Never expose this value to the frontend.
TELEGRAM_BOT_TOKEN=PASTE_STAGING_BOT_TOKEN_HERE

# Isolated staging database (separate from production).
DATABASE_URL=sqlite+aiosqlite:///./dongi_staging.db

# The staging bot talks to the staging API on the same VPS.
API_BASE_URL=http://127.0.0.1:8100

# Public Mini App URL and allowed browser origin.
MINI_APP_URL=https://dangi-staging.nexusetrade.ir
CORS_ORIGINS=https://dangi-staging.nexusetrade.ir

# Application secrets - use staging-only values, different from production.
APP_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STAGING_SECRET
SERVICE_API_TOKEN=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_STAGING_TOKEN

# API security
API_AUTH_REQUIRED=true
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
